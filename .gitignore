# ==============================================================================
# OceanguardAI-App - Android Mobile Application
# ==============================================================================

# Android build artifacts
android/.gradle/
android/.idea/
android/.kotlin/
android/local.properties
# Firebase client config for App Check (per developer, downloaded from the Firebase console)
android/app/google-services.json
android/app/build/
android/app/.cxx/
android/build/
*.hprof

# Gradle wrapper (keep gradle-wrapper.jar if needed)
# android/gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
.vscode/

# Model files (too large for git)
*.tflite
*.onnx
*.pt
*.pth
*.bin
*.task
*.litertlm
*.param
*.gguf
*.safetensors

# Models are downloaded at run time (or copied by scripts/setup-models); never commit them.

# Python
__pycache__/
*.py[codz]
*.egg-info/
.venv/
venv/
env/

# Signing keys
*.jks
*.keystore
keystore.properties

# Environment & credentials
.env
.env.*
*.token
hf_token.txt
credentials*.json
*.pem
*.p12

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Debug logs
logcat*.txt
*.log

# Compiled native code
android/app/src/main/jniLibs/
*.so

# APK / AAB
*.apk
*.aab

# Docker (not needed for app repo)
docker/
docker-compose*.yml
Dockerfile*

# Screenshots & temp
screenshots/

# Local tooling and AI-assistant config (kept out of the public repo)
.cursor/
.continue/

# Local artifacts that should never reach a public snapshot
*.html
!docs/gh-pages/index.html
dumpstate-*.zip
graphify-out/
bugreport-*.zip

# Build outputs delivered to the author (APKs, reference images)
dist/
